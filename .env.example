# Copy to .env and fill in. Only VITE_-prefixed vars reach the browser —
# anything secret belongs in Supabase Edge Function secrets, never here.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase anon / publishable key. Safe to ship to the browser: it grants no access
# beyond what row-level security allows. Never use the service_role key here.
VITE_SUPABASE_ANON_KEY=
